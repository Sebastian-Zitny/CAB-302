<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.jth_mathgame.mathgame.controller.RegisterMenuController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <VBox alignment="CENTER" spacing="20.0">
        <Label fx:id="titleText"/>
    </VBox>



    <VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml">
        <Label text="Input your Username:"/>
        <TextField fx:id="usernameTextField"/>
        <Label text="Input your Password:"/>
        <PasswordField fx:id="passwordTextField"/>
        <Label text="Input your Email:"/>
        <TextField fx:id="emailTextField"/>
        <Label text="Input your Phone number:"/>
        <TextField fx:id="phoneTextField"/>
        <Button fx:id="registerButton" text="Register" minWidth="200" minHeight="40" onAction="#onRegisterClick"/>
        <Button fx:id="backButton" text="Back" minWidth="200" minHeight="40" onAction="#onBackClick"/>
    </VBox>
</VBox>