<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.jth_mathgame.mathgame.GameController"
      prefHeight="400.0" prefWidth="600.0">

    <GridPane alignment="TOP_LEFT" minHeight="100">
        <padding>
            <Insets top="20" bottom="20" left="20" right="20"/>
        </padding>
        <Button text="Quit"
                fx:id="quitButton"
                prefHeight="25.0"
                prefWidth="50.0"
                GridPane.columnIndex="0"
                GridPane.rowIndex="0"
        />
        <Label text="Level X"
               fx:id="levelLabel"
               GridPane.columnIndex="1"
               GridPane.rowIndex="0"/>
        <Label text="[Time remaining]"
               fx:id="timeLabel"
               GridPane.columnIndex="2"
               GridPane.rowIndex="0"/>
        <VBox GridPane.columnIndex="1"
              GridPane.rowIndex="1">
            <Label text="[Question Here]"
                   fx:id="questionLabel"/>
            <TextField fx:id="inputField"/>
            <Button text="Submit"
                    fx:id="submitButton"/>
        </VBox>
    </GridPane>
</VBox>
