<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>


<VBox alignment="TOP_LEFT" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.jth_mathgame.mathgame.settingController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
        <VBox alignment="TOP_CENTER" spacing="10">
         <Label scaleX="2" scaleY="2" text="Audio Settings" textAlignment="RIGHT"/>
        </VBox>
         <Label fx:id="masterVolumeLabel" text="Master Volume" />
         <Slider fx:id="masterVolume" min="0" max="1" value="0.5" blockIncrement="5" prefWidth="50" minWidth="50" maxWidth="500"/>
         <Label fx:id="musicVolumeLabel" text="Music Volume" />
         <Slider fx:id="musicVolume" min="0" max="1" value="0.5" blockIncrement="5" prefWidth="50" minWidth="50" maxWidth="500"/>
    <VBox alignment="BOTTOM_LEFT" spacing="20">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>
        <Button fx:id="backButton" text="Back" onAction="#backToMenu"/>
    </VBox>
</VBox>


