<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.jth_mathgame.mathgame.StatsController">
            <center>
            <VBox alignment="CENTER" spacing = "20">
                <TableView  fx:id="statsView" layoutX="20.0" layoutY="20.0" prefHeight="200.0" prefWidth="300.0">
                    <columns>
                        <TableColumn fx:id="username" text="Username" />
                        <TableColumn fx:id="score" text="Score" />
                    </columns>
            </TableView>
            <Button text="Back" fx:id="backButton" style="-fx-font-size: 24;" onAction="#onBackButtonClick"/>

            </VBox>
            </center>

</BorderPane>