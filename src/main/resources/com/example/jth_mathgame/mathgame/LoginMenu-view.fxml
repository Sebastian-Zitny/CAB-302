<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.jth_mathgame.mathgame.LoginMenuController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <VBox alignment="CENTER" spacing="20.0">
        <Label fx:id="titleText"/>
    </VBox>



    <VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml">
        <Label text="Username:"/>
        <TextField fx:id="usernameTextField"/>
        <Label text="Password:"/>
        <TextField fx:id="passwordTextField"/>
        <Button fx:id="submitButton" text="Submit" minWidth="200" minHeight="40" onAction="#onSubmitClick"/>
    </VBox>
</VBox>