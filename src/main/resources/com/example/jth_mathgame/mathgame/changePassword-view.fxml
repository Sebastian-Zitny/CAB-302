<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.jth_mathgame.mathgame.ChangePasswordController">
    <center>
        <VBox alignment="CENTER" spacing="20">
            <HBox alignment="CENTER" spacing="20">
                <Label text="Change password" style="-fx-font-size: 36; -fx-font-family: Impact;" />
            </HBox>
            <HBox alignment="CENTER" spacing="20.0" >
                <Label text="Current password:"/>
                <PasswordField fx:id="currentPasswordField"/>
            </HBox>
            <HBox alignment="CENTER" spacing="20.0" >
            </HBox>
            <HBox alignment="CENTER" spacing="20.0" >
                <Label text="New password:"/>
                <PasswordField fx:id="newPasswordField"/>
            </HBox>

            <Region minHeight="15" />

            <HBox alignment="CENTER" spacing="20.0" >
                <Button text="Back" fx:id="backButton" style="-fx-font-size: 24;" onAction="#onBackClick" />
                <Button text="Confirm" fx:id="confirmButton" style="-fx-font-size: 24;" />
            </HBox>
        </VBox>
    </center>
</BorderPane>