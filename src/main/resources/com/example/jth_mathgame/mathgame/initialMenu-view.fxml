<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.jth_mathgame.mathgame.InitialMenuController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <VBox alignment="CENTER" spacing="20.0">
        <Label fx:id="titleText"/>
    </VBox>

    <VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml">
        <Button fx:id="loginButton" text="Login" minWidth="200" minHeight="40" onAction="#onLoginClick"/>
        <Button fx:id="registerButton" text="Register" minWidth="200" minHeight="40" onAction="#onRegisterClick"/>
        <Button fx:id="quitButton" text="Quit" minWidth="200" minHeight="40" onAction="#onQuitButtonClick"/>
    </VBox>
</VBox>